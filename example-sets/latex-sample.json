{
  "id": "latex-test",
  "title": "LaTeX Smoke Test",
  "section": "Quantitative Reasoning",
  "minutes": 5,
  "note": "Checks inline $..$, display $$..$$, and math in choices and tables.",
  "questions": [
    {
      "topic": "Algebra",
      "diff": "Medium",
      "target": 120,
      "stem": "If $x^2 - 5x + 6 = 0$ and $x > 2$, what is the value of $\\sqrt{x^3}$?\n$$\\frac{x^2 - 9}{x - 3} = x + 3$$",
      "choices": ["$3\\sqrt{3}$", "$2\\sqrt{6}$", "$\\frac{27}{2}$", "$9$", "$\\sqrt[3]{27}$"],
      "answer": 0,
      "why": "Roots are $x = 2$ and $x = 3$; since $x > 2$, $x = 3$, so $\\sqrt{x^3} = \\sqrt{27} = 3\\sqrt{3}$."
    },
    {
      "topic": "Table Analysis",
      "diff": "Hard",
      "target": 150,
      "stimulus": {
        "text": "Growth rates satisfy $r = \\left(\\frac{V_1}{V_0}\\right)^{1/t} - 1$.",
        "table": { "headers": ["Fund", "$V_0$", "$V_1$", "$t$"], "rows": [["A", "$1{,}000$", "$1{,}331$", "$3$"], ["B", "$800$", "$968$", "$2$"]] }
      },
      "stem": "Which funds have $r \\geq 10\\%$? Select all that apply.",
      "type": "multi",
      "choices": ["Fund A", "Fund B", "Neither"],
      "answers": [0, 1],
      "why": "A: $1.331^{1/3} = 1.10$. B: $\\sqrt{1.21} = 1.1$. Both equal exactly $10\\%$."
    },
    {
      "topic": "Two-Part Analysis",
      "diff": "Medium",
      "target": 160,
      "stem": "Select values so that $a + b = 12$ and $\\frac{a}{b} = 2$. Bad math check: $\\frac{1}{$.",
      "type": "twopart",
      "twoPartHeaders": ["$a$", "$b$"],
      "choices": ["$2$", "$4$", "$6$", "$8$", "$10$"],
      "answers": [3, 1],
      "why": "$a = 8$, $b = 4$."
    }
  ]
}
